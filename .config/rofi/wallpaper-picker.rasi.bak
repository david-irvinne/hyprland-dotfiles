configuration {
    modi:                       "dmenu";
    show-icons:                 true;
    font:                       "JetBrainsMono Nerd Font Extra Bold Italic 12";
    click-to-exit:              true;
    disable-history:            false;
    location:                   0;
}

// Global Properties
* {
    main-bg:                    rgba(25, 25, 35, 0.95);
    main-fg:                    #e8e3e3;
    select-bg:                  rgba(109, 75, 189, 0.4);
    select-fg:                  #ffffff;
    input-bg:                   rgba(35, 35, 45, 0.5);
    input-fg:                   #e8e3e3;
    input-border:               rgb(142, 89, 201);
    accent-color:               #8E59C9;
    no-color-transparent:       rgba(0, 0, 0, 0);
    backdrop:                   rgba(0, 0, 0, 0.8);
}

// Window
window {
    enabled:                    true;
    fullscreen:                 true;
    width:                      100%;
    height:                     100%;
    padding:                    0px;
    border:                     1px solid;
    border-radius:              0px;
    border-color:               transparent;
    background-color:           @backdrop;
}

// Main Box
mainbox {
    enabled:                    true;
    children:                   ["inputbar", "listview"];
    spacing:                    35px;
    padding:                    7% 5%;
    background-color:           @no-color-transparent;
}

// Input Bar
inputbar {
    enabled:                    true;
    spacing:                    5px;
    padding:                    10px 15px;
    margin:                     0px 100px;
    border:                     1px solid;
    border-radius:              10px;
    border-color:               @input-border;
    background-color:           @input-bg;
    text-color:                 @input-fg;
    children:                   ["prompt", "entry"];
}

prompt {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @accent-color;
    font:                       "JetBrainsMono Nerd Font Extra Bold 12";
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @input-fg;
    cursor:                     text;
    placeholder:                "壁紙を検索...";
    placeholder-color:          rgba(212, 197, 169, 0.35);
    font:                       "JetBrainsMono Nerd Font Regular 12";
}

// Listview — 5 kolom, 1–2 baris (filmstrip horizontal)
listview {
    enabled:                    true;
    columns:                    5;
    lines:                      1;
    spacing:                    18px;
    padding:                    5px 15px;
    background-color:           @no-color-transparent;
    text-color:                 @main-fg;
    cycle:                      true;
    dynamic:                    false;
    scrollbar:                  false;
    fixed-height:               false;
    reverse:                    false;
}

// Elements
element {
    enabled:                    true;
    padding:                    10px;
    border-radius:              12px;
    background-color:           @no-color-transparent;
    text-color:                 @main-fg;
    cursor:                     pointer;
    orientation:                vertical;
}

element normal.normal {
    background-color:           @no-color-transparent;
    text-color:                 @main-fg;
}

element alternate.normal {
    background-color:           rgba(0, 0, 0, 0);
    text-color:                 @main-fg;
}

element selected.normal {
    background-color:           @select-bg;
    text-color:                 @select-fg;
    border:                     1px solid;
    border-color:               @accent-color;
    border-radius:              12px;
}

// Icon besar portrait
element-icon {
    size:                       240px;
    background-color:           transparent;
    border-radius:              8px;
    margin:                     0px;
}

element-text {
    // vertical-align:             0.5;
    // horizontal-align:           0.5;
    // padding:                    10px 0px 2px 0px;
    // background-color:           transparent;
    // text-color:                 inherit;
    // font:                       "JetBrainsMono Nerd Font Regular 10";
    size:                       0px;
    padding:                    0px;
    background-color:           transparent;
    text-color:                 transparent;
}
