configuration {
    modi:                       "dmenu";
    show-icons:                 true;
    font:                       "JetBrainsMono Nerd Font Extra Bold Italic 12";
    click-to-exit:              true;
    disable-history:            false;
    location:                   0;
}

* {
    main-bg:                    rgba(25, 25, 35, 0.95);
    main-fg:                    #e8e3e3;
    select-bg:                  rgba(109, 75, 189, 0.4);
    select-fg:                  #ffffff;
    input-bg:                   rgba(35, 35, 45, 0.5);
    input-fg:                   #e8e3e3;
    input-border:               rgb(142, 89, 201);
    accent-color:               #8E59C9;
    no-color-transparent:       rgba(0, 0, 0, 0);
    backdrop:                   rgba(0, 0, 0, 0.5);
}

window {
    fullscreen:                 true;
    background-color:           @backdrop;
    border:                     0px;
    padding:                    0px;
}

mainbox {
    children:                   ["inputbar", "listview"];
    spacing:                    30px;
    padding:                    22% 5%;
    background-color:           @no-color-transparent;
}

inputbar {
    spacing:                    5px;
    padding:                    10px 15px;
    margin:                     0px 80px;
    border:                     2px solid;
    border-radius:              15px;
    border-color:               @input-border;
    background-color:           @input-bg;
    text-color:                 @input-fg;
    children:                   ["prompt", "entry"];
}

prompt {
    background-color:           transparent;
    text-color:                 @accent-color;
    font:                       "JetBrainsMono Nerd Font Extra Bold 12";
}

entry {
    background-color:           transparent;
    text-color:                 @input-fg;
    cursor:                     text;
    placeholder:                "壁紙を検索...";
    placeholder-color:          rgba(232, 227, 227, 0.4);
    font:                       "JetBrainsMono Nerd Font Regular 12";
}

listview {
    columns:                    5;
    lines:                      1;
    spacing:                    20px;
    padding:                    0px 10px;
    background-color:           @no-color-transparent;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    fixed-height:               false;
    fixed-columns:              true;
}

element {
    padding:                    8px;
    border-radius:              12px;
    background-color:           @no-color-transparent;
    text-color:                 @main-fg;
    cursor:                     pointer;
    orientation:                vertical;
}

element normal.normal {
    background-color:           @no-color-transparent;
    text-color:                 @main-fg;
}

element alternate.normal {
    background-color:           @no-color-transparent;
    text-color:                 @main-fg;
}

element selected.normal {
    background-color:           @select-bg;
    text-color:                 @select-fg;
    border:                     2px solid;
    border-color:               @accent-color;
    border-radius:              12px;
}

element-icon {
    size:                       320px;
    background-color:           transparent;
    border-radius:              8px;
    margin:                     0px;
}

// Sembunyikan filename
element-text {
    padding:                    0px;
    margin:                     0px;
    background-color:           transparent;
    text-color:                 transparent;
}
